# PostgreSQL — utiliser une base persistante et protégée en production
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# URL publique utilisée pour les métadonnées et le sitemap
NEXT_PUBLIC_SITE_URL=https://ludoconsulting.vercel.app

# Authentification de l'unique compte propriétaire configuré par environnement
ADMIN_EMAIL=admin@example.com
# Format : scrypt:<salt_hex>:<hash_hex_64_bytes> — générer une empreinte, jamais un mot de passe en clair
# (les séparateurs « : » évitent l'interprétation des « $ » par les chargeurs de fichiers .env)
ADMIN_PASSWORD_HASH=
# Secret aléatoire de signature de session, 32 caractères minimum
ADMIN_SESSION_SECRET=

# Espace membre (connexion / inscription des visiteurs)
# Secret de signature des sessions membres ; si absent, ADMIN_SESSION_SECRET est utilisé.
MEMBER_SESSION_SECRET=

# Connexion avec Google (OAuth 2.0) — voir README « Connexion Google » pour la procédure
# L'URI de redirection à enregistrer dans Google Cloud Console est :
#   https://VOTRE-DOMAINE/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
