# PostgreSQL — utiliser une base persistante et protégée en production
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# URL publique utilisée pour les métadonnées et le sitemap
NEXT_PUBLIC_SITE_URL=https://ludoconsulting.vercel.app

# Authentification de l'unique compte propriétaire configuré par environnement
ADMIN_EMAIL=ludo.consulting3@gmail.com
# Format : scrypt:<salt_hex>:<hash_hex_64_bytes> — générer une empreinte, jamais un mot de passe en clair
# (les séparateurs « : » évitent l'interprétation des « $ » par les chargeurs de fichiers .env)
ADMIN_PASSWORD_HASH=
# Secret aléatoire de signature de session, 32 caractères minimum
ADMIN_SESSION_SECRET=

# Connexion Google des membres (console Google Cloud → Identifiants → ID client OAuth 2.0)
# URI de redirection à déclarer côté Google : https://VOTRE-DOMAINE/api/member/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
